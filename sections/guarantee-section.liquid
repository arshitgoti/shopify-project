{%- style -%}
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  #Guarantee-{{ section.id }} .guarantee-section__inner {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.content_gap }}px;
    background-color: {{ section.settings.background_color }};
    border-radius: {{ section.settings.container_radius }}px;
    padding: {{ section.settings.inner_padding }}px;
    box-sizing: border-box;
  }

  #Guarantee-{{ section.id }} .guarantee-section__media,
  #Guarantee-{{ section.id }} .guarantee-section__content {
    min-width: 0;
  }

  #Guarantee-{{ section.id }} .guarantee-section__media img,
  #Guarantee-{{ section.id }} .guarantee-section__placeholder {
    display: block;
    width: 100%;
    border-radius: {{ section.settings.image_radius }}px;
    object-fit: cover;
  }

  #Guarantee-{{ section.id }} .guarantee-section__placeholder {
    aspect-ratio: 4 / 5;
    background: #e8e0e0;
  }

  #Guarantee-{{ section.id }} .guarantee-section__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  #Guarantee-{{ section.id }} .guarantee-section__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.3;
  }

  #Guarantee-{{ section.id }} .guarantee-section__divider {
    height: 1px;
    margin: 1rem 0 1.25rem;
    background-color: {{ section.settings.divider_color }};
    border: 0;
  }

  #Guarantee-{{ section.id }} .guarantee-section__text {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.65;
  }

  #Guarantee-{{ section.id }} .guarantee-section__text p {
    margin: 0 0 1em;
  }

  #Guarantee-{{ section.id }} .guarantee-section__text p:last-child {
    margin-bottom: 0;
  }

  @media screen and (min-width: 750px) {
    #Guarantee-{{ section.id }} .guarantee-section__inner {
      flex-direction: {% if section.settings.image_position == 'right' %}row-reverse{% else %}row{% endif %};
      align-items: stretch;
    }

    #Guarantee-{{ section.id }} .guarantee-section__media,
    #Guarantee-{{ section.id }} .guarantee-section__content {
      flex: 1 1 0;
    }

    #Guarantee-{{ section.id }} .guarantee-section__media img,
    #Guarantee-{{ section.id }} .guarantee-section__placeholder {
      height: 100%;
      min-height: 280px;
    }
  }
{%- endstyle -%}

<div id="Guarantee-{{ section.id }}" class="guarantee-section">
  <div class="page-width">
    <div class="guarantee-section__inner">
      <div class="guarantee-section__media">
        {%- if section.settings.image != blank -%}
          {%- liquid
            assign image_alt = section.settings.image_alt | default: section.settings.image.alt | escape
          -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: image_alt
          }}
        {%- else -%}
          <div class="guarantee-section__placeholder" role="img" aria-label="{{ section.settings.image_alt | default: 'Guarantee image' | escape }}"></div>
        {%- endif -%}
      </div>

      <div class="guarantee-section__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="guarantee-section__heading">{{ section.settings.heading | escape }}</h2>
          <hr class="guarantee-section__divider">
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="guarantee-section__text rte">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Guarantee section",
  "tag": "section",
  "class": "section-guarantee",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Customer with glowing skin"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Image border radius",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "60 Day Guarantee"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading font size",
      "default": 28
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Glow or Get Your Money Back. We have great confidence you will love your Quia products! If you don't see results, you may qualify for a refund.</p><p>Everyone's growth journey is different however, we're so confident in our enhancing serums that we're offering a 60-day risk-free trial!</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description font size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8EDED"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#A65E5E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider",
      "default": "#E0D0D0"
    },
    {
      "type": "header",
      "content": "Spacing & style"
    },
    {
      "type": "range",
      "id": "container_radius",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Container border radius",
      "default": 24
    },
    {
      "type": "range",
      "id": "inner_padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Inner padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 16,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Gap between image and content",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section margin top",
      "default": 36
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Section margin bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Guarantee section"
    }
  ]
}
{% endschema %}
